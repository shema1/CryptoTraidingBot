# Приклад змінних оточення. Значень тут немає й не буде (секрети лише в .env).
# Скопіюйте:  cp .env.example .env && chmod 600 .env
# Кожна змінна, яку читає конфіг (apps/backend/app/core/config.py), має бути тут —
# це перевіряє тест apps/backend/tests/test_env_example.py. Порожнє значення = default.

# --- Логування (apps/backend/app/core/logging.py, ТЗ §12) ---
# Рівень логування: DEBUG | INFO | WARNING | ERROR (за замовчуванням INFO)
LOG_LEVEL=
# Тека логів (за замовчуванням <корінь репозиторію>/logs; відносний шлях — від кореня). Підтека на процес.
LOG_DIR=
# Розмір файла до ротації, байти: 1048576 … 1073741824 (за замовчуванням 52428800 = 50 MiB)
LOG_MAX_BYTES=
# Кількість ротованих копій на файл: 1 … 100 (за замовчуванням 10)
LOG_BACKUP_COUNT=
# Дублювати логи в stderr: true | false (за замовчуванням true)
LOG_CONSOLE=

# --- База даних (docker-compose.yml, ТЗ §12.2; DSN для бекенду й Alembic — Settings.database_url()) ---
# Хост БД — лише loopback: 127.0.0.1 | localhost | ::1 (за замовчуванням 127.0.0.1)
POSTGRES_HOST=
# Порт БД: 1 … 65535 (за замовчуванням 5432)
POSTGRES_PORT=
# Ім'я основної БД та її власника (за замовчуванням ctb). Тестова БД для integration-тестів — <ім'я>_test.
POSTGRES_DB=
POSTGRES_USER=
# ОБОВ'ЯЗКОВІ для `docker compose up` (без них compose завершиться помилкою). Задайте довгі випадкові значення.
POSTGRES_PASSWORD=
# Пароль read-only ролі ctb_readonly. Застосовується лише при першій ініціалізації volume;
# пізніша зміна — через ALTER ROLE ctb_readonly PASSWORD ... у psql.
POSTGRES_READONLY_PASSWORD=

# --- Single-instance lock торгового процесу і воркера (apps/backend/app/core/instance_lock.py, ТЗ §6.4) ---
# Скільки секунд при старті повторювати спроби взяти lock: 0 … 600 (за замовчуванням 60; 0 — одна спроба).
# Не вдалося — процес завершується й пише в лог, яка сесія тримає lock. Кожен процес має свій lock.
LOCK_WAIT_S=

# --- Локальний API торгового процесу (apps/backend/app/api, ТЗ §14, §16) ---
# API слухає лише 127.0.0.1 (не налаштовується). Порт: 1024 … 65535 (за замовчуванням 8000).
API_PORT=
# ОБОВ'ЯЗКОВИЙ: bearer-токен UI, щонайменше 32 символи [A-Za-z0-9._~+/-] (≥ 10 різних). Без нього процес не стартує.
# Згенерувати:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Origins UI, яким дозволено звертатися до API (перевірка Origin і CORS), через кому. Лише loopback з явним
# портом і без шляху: http(s)://127.0.0.1|localhost|[::1]:<порт>. За замовчуванням http://127.0.0.1:5173 (Vite).
API_ALLOWED_ORIGINS=

# --- Частки спільного IP-ліміту Bybit (apps/backend/app/exchange/rate_limit.py, ТЗ §6.5) ---
# Файл спільний для торгового процесу, воркера й колектора, тож роль процесу тут не задається — її визначає
# команда запуску. Частки мають бути однакові для всіх трьох процесів.
# Частка торгового процесу, % IP-ліміту: 1 … 98 (за замовчуванням 50). Сума трьох часток — рівно 100.
RATE_LIMIT_SHARE_TRADING_PCT=
# Частка воркера, % IP-ліміту: 1 … 98 (за замовчуванням 30).
RATE_LIMIT_SHARE_WORKER_PCT=
# Частка колектора, % IP-ліміту: 1 … 98 (за замовчуванням 20).
RATE_LIMIT_SHARE_COLLECTOR_PCT=

# --- Backfill свічок 1h і funding (apps/backend/app/data/backfill.py, ТЗ §4.1, §4.4) ---
# Торговий символ. Свічки качаються і для нього, навіть якщо його немає в RESEARCH_SYMBOLS.
# Канонічний формат CCXT (за замовчуванням BTC/USDT:USDT).
TRADING_SYMBOL=
# 5–8 USDT-perpetual для навчання, через кому (ТЗ §5А.6). За замовчуванням
# BTC, ETH, SOL, XRP, BNB, DOGE, ADA, LTC — усі як <МОНЕТА>/USDT:USDT.
RESEARCH_SYMBOLS=
# Початок історії, мс UTC, кратний 1 годині (3600000). Раніше за цю мить backfill не ходить
# (за замовчуванням 1577836800000 = 2020-01-01T00:00:00Z).
BACKFILL_START_MS=
# Як часто повторювати інкрементальне докачування, секунди: 60 … 86400 (за замовчуванням 600).
BACKFILL_INTERVAL_S=

# --- Час (apps/backend/app/data/time_sync.py, ТЗ §4.3) ---
# recvWindow приватних запитів Bybit, мс: 2000 … 10000 (за замовчуванням 5000 — як у Bybit). Діє з появою торгового
# клієнта (T3.2). Біржа приймає запит, лише якщо його час не старіший за recvWindow і не випереджає біржу на 1 с і
# більше. Більше вікно не лікує розбіжність годинника (її виправляє NTP), а лише дозволяє виконати запит, що застряг у
# мережі.
RECV_WINDOW_MS=
