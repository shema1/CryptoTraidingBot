# Приклад змінних оточення. Значень тут немає й не буде (секрети лише в .env).
# Скопіюйте:  cp .env.example .env && chmod 600 .env
# Кожна змінна, яку читає конфіг (apps/backend/app/core/config.py), має бути тут —
# це перевіряє тест apps/backend/tests/test_env_example.py. Порожнє значення = default.

# --- Логування (apps/backend/app/core/logging.py, ТЗ §12) ---
# Рівень логування: DEBUG | INFO | WARNING | ERROR (за замовчуванням INFO)
LOG_LEVEL=
# Тека логів (за замовчуванням <корінь репозиторію>/logs; відносний шлях — від кореня). Підтека на процес.
LOG_DIR=
# Розмір файла до ротації, байти: 1048576 … 1073741824 (за замовчуванням 52428800 = 50 MiB)
LOG_MAX_BYTES=
# Кількість ротованих копій на файл: 1 … 100 (за замовчуванням 10)
LOG_BACKUP_COUNT=
# Дублювати логи в stderr: true | false (за замовчуванням true)
LOG_CONSOLE=

# --- База даних (docker-compose.yml, ТЗ §12.2) ---
# Ім'я основної БД та її власника (за замовчуванням ctb). Тестова БД для integration-тестів — <ім'я>_test.
POSTGRES_DB=
POSTGRES_USER=
# ОБОВ'ЯЗКОВІ для `docker compose up` (без них compose завершиться помилкою). Задайте довгі випадкові значення.
POSTGRES_PASSWORD=
# Пароль read-only ролі ctb_readonly. Застосовується лише при першій ініціалізації volume;
# пізніша зміна — через ALTER ROLE ctb_readonly PASSWORD ... у psql.
POSTGRES_READONLY_PASSWORD=
